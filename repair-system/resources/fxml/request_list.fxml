<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controller.RequestListController" spacing="15" styleClass="content-panel">

    <padding>
        <Insets top="20" right="25" bottom="20" left="25"/>
    </padding>

    <HBox spacing="15" alignment="CENTER_LEFT">
        <Label text="Заявки на ремонт" styleClass="page-title"/>
        <Region HBox.hgrow="ALWAYS"/>

        <TextField fx:id="searchField" promptText="Поиск по клиенту, модели, серийнику..."
                   prefWidth="300" styleClass="search-field"/>
        <Button text="🔍 Поиск" onAction="#search" styleClass="button-secondary"/>
        <Button text="🔄 Обновить" onAction="#refresh" styleClass="button-secondary"/>
        <Button text="🗑 Удалить" onAction="#deleteSelected" styleClass="button-danger"/>
    </HBox>

    <TableView fx:id="tableView" VBox.vgrow="ALWAYS" styleClass="modern-table">
        <columns>
            <TableColumn fx:id="colId" text="ID" prefWidth="60"/>
            <TableColumn fx:id="colClient" text="Клиент" prefWidth="180"/>
            <TableColumn fx:id="colDevice" text="Устройство" prefWidth="200"/>
            <TableColumn fx:id="colStatus" text="Статус" prefWidth="140"/>
            <TableColumn fx:id="colDate" text="Дата создания" prefWidth="150"/>
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
    </TableView>

    <HBox alignment="CENTER_LEFT">
        <Label fx:id="statusLabel" text="Всего заявок: 0" styleClass="status-text"/>
    </HBox>
</VBox>